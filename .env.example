# Configuration de l'application Sandia Assurance
# Copiez ce fichier vers .env et remplissez les valeurs appropriées

# Clé secrète pour les sessions et CSRF (CHANGEZ CECI EN PRODUCTION !)
SECRET_KEY=votre-cle-secrete-unique-et-longue-ici-changez-en-production

# Configuration de la base de données
# Pour SQLite (par défaut) : sqlite:///app.db
# Pour PostgreSQL : postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///app.db

# Configuration du serveur
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5002

# Configuration du rate limiting (utilise Redis en production)
# REDIS_URL=redis://localhost:6379/0

# Configuration des emails (pour les notifications futures)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=votre-email@gmail.com
# MAIL_PASSWORD=votre-mot-de-passe

# Clés API externes (si nécessaire)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...